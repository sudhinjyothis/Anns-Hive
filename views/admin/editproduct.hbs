<section class="addproductadmin">
    <div class="container">
        <div class="wrap">
            <h5 class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Edit Product
            </h5>
            <div class="signbg bg p-md-5 p-4 mx-auto mw-100">
                <!--/SignUp-form-->
                <form action="/SCmVRbJpEXjopyOHKFMaWTunotqPBj?id={{product._id}}" method="POST"
                    enctype="multipart/form-data" class="row g-3">
                    <div class="col-md-6 col-6">
                        <label for="" class="form-label">Name</label>
                        <input type="text" class="form-control" name="productName" id="productname"
                            value="{{product.productName}}">
                    </div>
                    <div class="col-md-6 col-6">
                        <label for="" class="form-label">Price</label>
                        <input type="number" class="form-control" name="productPrice" id="productprice"
                            value="{{product.productPrice}}">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="" class="form-label">description</label>
                        <input type="text" class="form-control" name="productDescription" id="productdescription"
                            value="{{product.productDescription}}">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="" class="form-label">Category</label>
                        <input type="text" class="form-control" name="productCategory" id="productcategory"
                            value="{{product.productCategory}}">
                    </div>
                    <div class="col-md-6 col-12">
                        <img src="/images/products/{{product._id}}.jpg" alt="img" alt=""
                            style="margin-top: 10px;width: 100px;height: 100px;" id="imgView">
                    </div>
                    <div class="col-md-6 col-12">
                        <span id="imgwarningtext" for="" class="text-danger imgwarningtext">please upload jpg
                            files!</span>
                        <label for="" class="form-label">image1<span class="text-warning">(recommended file type :
                                jpeg)</span></label>
                        <input onchange="viewImage(event)" type="file" class="form-control" name="productImage1"
                            id="productimage1">
                    </div>
                    <div class="col-md-6 col-12">
                        <img src="/images/products/{{product._id}}1.jpg" alt="img" alt=""
                            style="margin-top: 10px;width: 100px;height: 100px;" id="imgView1">
                    </div>
                    <div class="col-12 col-md-6">
                        <span id="imgwarningtext1" for="" class="text-danger imgwarningtext">please upload jpg
                            files!</span>
                        <label for="" class="form-label">image2</label>
                        <input onchange="viewImage1(event)" type="file" class="form-control" name="productImage2"
                            id="productimage2" placeholder="1234 Main St">
                    </div>
                    <div class="col-md-6 col-12">
                        <img src="/images/products/{{product._id}}2.jpg" alt=""
                            style="margin-top: 10px;width: 100px;height: 100px;" id="imgView2">
                    </div>
                    <div class="col-md-6 col-12">
                        <span id="imgwarningtext2" for="" class="text-danger imgwarningtext">please upload jpg
                            files!</span>
                        <label for="" class="form-label">image 3</label>
                        <input onchange="viewImage2(event)" type="file" class="form-control" name="productImage3"
                            id="productimage3">
                    </div>
                    <div class="col-12">
                        <button id="imgwarningbtn" style="margin-bottom: 10px;" type="submit"
                            class="btn btn-outline-warning">Edit
                            Product</button>
                    </div>
                </form>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
</section>