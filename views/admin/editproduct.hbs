                    </div>
                    <div class="col-md-6 col-12">
                        <img src="" alt="img" alt="" style="margin-top: 10px;width: 100px;height: 100px;" id="imgView3">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputState" class="form-label">image 4</label>
                        <input onchange="viewImage3(event)" type="file" class="form-control" id="inputCity">
                    </div>
                    <div class="col-12">
                        <button style="margin-bottom: 10px;" type="submit" class="btn btn-outline-warning">Edit
