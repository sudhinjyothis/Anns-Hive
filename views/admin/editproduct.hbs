                    </div>
                    <div class="col-md-6 col-12">
                        <img src="" alt="img" alt="" style="margin-top: 10px;width: 100px;height: 100px;" id="imgView2">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputCity" class="form-label">image 3</label>
