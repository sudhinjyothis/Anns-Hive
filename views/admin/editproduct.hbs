                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputPassword4" class="form-label">Category</label>
                        <input type="text" class="form-control" id="inputPassword4">
                    </div>
                    <div class="col-md-6 col-12">
                        <img src="" alt="img" alt="" style="margin-top: 10px;width: 100px;height: 100px;" id="imgView">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputPassword4" class="form-label">image1</label>
                        <input onchange="viewImage(event)" type="file" class="form-control" id="inputPassword4">
                    </div>
                    <div class="col-md-6 col-12">
                        <img src="" alt="img" alt="" style="margin-top: 10px;width: 100px;height: 100px;" id="imgView1">
                    </div>
                    <div class="col-12 col-md-6">
