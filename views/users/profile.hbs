<section class="signupcontainer">
    <div class="container">
        <div class="wrap">
            <h5 class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Profile
            </h5>
            <div class="signupbg bg p-md-5 p-4 mx-auto mw-100 ">
                <!--/SignUp-form-->
                {{#if socialmedia}}
                <form class="row g-3">
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Name</label>
                        <input type="text" value="{{user.name}}" class="form-control" name="name" disabled>
                    </div>
                    <div class="col-md-12 col-12 ">
                        <label for="email" class="form-label">Email </label>
                        <input type="email" class="form-control" value="{{user.email}}" name="email" disabled>
                    </div>
                    <div class="col-md-12 col-12 signupemail">
                        <label class="form-label">Mobile</label>
                        <div style="display: flex;">
                            {{#if user.mobile}}
                            <input type="number" class="form-control" value="{{user.mobile}}" name="mobile" disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Edit</a>
                            {{else}}
                            <input type="text" class="form-control" value="please add your mobile number" name="email"
                                disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Add</a>
                            {{/if}}
                        </div>
                    </div>
                </form>
                {{else}}
                <form class="row g-3">
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Name</label>
                        <div style="display: flex;">
                            <input type="text" value="{{user.name}}" class="form-control" name="name" disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Edit</a>
                        </div>
                    </div>
                    <div class="col-md-12 col-12 ">
                        <label for="email" class="form-label">Email </label>
                        <div style="display: flex;">
                            <input type="email" class="form-control" value="{{user.email}}" name="email" disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Edit</a>
                        </div>
                    </div>
                    <div class="col-md-12 col-12 signupemail">
                        <label for="email" class="form-label">Mobile</label>
                        <div style="display: flex;">
                            {{#if user.mobile}}
                            <input type="text" class="form-control" value="{{user.mobile}}" name="mobile"
                                id="editmobile" disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Edit</a>
                            {{else}}
                            <input type="email" class="form-control" value="please add your mobile number" name="email"
                                disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Add</a>
                            {{/if}}
                        </div>
                    </div>
                    <div class="col-md-12 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <div style="display: flex;">
                            <input type="password" maxlength="16" class="form-control" name="password" id="editPassword"
                                value="123456213" disabled>
                            <a style="margin-left: 20px;" href="" class="btn btn-dark">Edit</a>
                        </div>
                    </div>
                </form>
                {{/if}}
            </div>
            <h5 id="address" class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Address
            </h5>
            <div class="addressbg bg p-md-5 p-4 mx-auto mw-100 ">
                <!--/SignUp-form-->
                {{#if address}}
                {{#if limitExceeded}}
                <div class="d-flex align-content-end">
                    <h2 for="">Maximum address allowed is 5</h2>
                    <a style="margin-right: 0;margin-left: auto;" href="/" class="btn btn-dark disabled">Add
                        address</a>
                </div>
                {{else}}
                <div class="d-flex align-content-end">
                    <a style="margin-right: 0;margin-left: auto;" href="/addaddress" class="btn btn-dark">Add
                        address</a>
                </div>
                {{/if}}
                {{#each address}}
                <h5 style="margin-top: 20px;">Address - {{increment @index}}</h5>
                <form class="row g-3">
                    <div class="col-md-6 col-12">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="addressname" value="{{this.name}}" disabled>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="addressemail" value="{{this.email}}" disabled>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Phone number</label>
                        <input type="number" maxlength="13" class="form-control" name="addressmobile"
                            value="{{this.mobile}}" disabled>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Alternate number (optional)</label>
                        <input type="number" maxlength="13" class="form-control" name="addressmobile2"
                            value="{{address.mobile2}}" disabled>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Address Line 1 </label>
                        <input type="text" class="form-control" name="addressline1" value="{{this.line1}}" disabled>
                    </div>
                    <div class="col-md-6 col-12">
                        <label class="form-label">Address Line 2 </label>
                        <input type="text" class="form-control" name="addressline2" value="{{this.line2}}" disabled>
                    </div>
                    <div class="col-md-4 col-12">
                        <label class="form-label">State</label>
                        <input type="text" class="form-control" name="addressstate" value="{{this.state}}" disabled>
                    </div>
                    <div class="col-md-4 col-12">
                        <label class="form-label">City</label>
                        <input type="text" class="form-control" name="addresscity" value="{{this.city}}" disabled>
                    </div>
                    <div class="col-md-4 col-12">
                        <label class="form-label">Pincode</label>
                        <input type="number" class="form-control" name="addresspin" value="{{this.pincode}}" disabled>
                    </div>
                    <div class="col-md-6 col-12 addressctrlbtn">
                        <a href="/editaddress?id={{@index}}" class="btn btn-dark">Edit Address</a>
                        <a style="margin-left: 10px;" href="/api/deleteaddress?email={{this.email}}"
                            onclick="return confirm('Are you sure want to delete {{this.name}}')" class=" btn
                            btn-danger">Delete Address</a>
                    </div>
                </form>
                {{/each}}
                {{else}}
                <div class="noaddress" style="text-align: center;">
                    <h3>No address found , please add your shipping address</h3>
                    <a style="margin-top: 10px;" href="/addaddress" class="btn btn-dark">Add
                        address</a>
                </div>

                {{/if}}
            </div>
        </div>
    </div>
</section>