<section class="editaddresscontainer">
    <div class="container">
        <div class="wrap">
            <h5 id="address" style="padding-top: 175px;" class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Cart
            </h5>
            <div class="mycartbg bg mx-auto mw-100 ">
                {{#if products}}
                <div class="container px-4 py-5 mx-auto">
                    <div class="row d-flex ">
                        <div class="col-5 ">
                            <h4 class="heading">Cart</h4>
                        </div>
                        <div class="col-7">
                            <div style="justify-content: flex-end;" class="row text-right">
                                <div class="col-4">
                                    <h6 class="mt-2">Price</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{#each products}}
                    <div id="{{this.product._id}}" class="row d-flex justify-content-center border-top">
                        <div class="col-5 p-0">
                            <div class=" d-flex">
                                <div class="product">
                                    <a href=""><img src="images/products/{{this.product._id}}.jpg" class="pro-img"></a>
                                </div>
                                <div class="my-auto flex-column d-flex ">
                                    <a href="" class="cartproductname">
                                        {{this.product.productName}}
                                    </a>
                                    <p class="mob-text">{{this.product.productCategory}}</p>
                                    <div style="width: 103px;" class="cartqtylabel">Qty :
                                        <input type="number" value="{{this.quantity}}" id="{{this.product._id}}"
                                            class="cartquantityvalue"
                                            onchange="changeQuantity('{{this._id}}','{{this.product._id}}',this.value,{{this.product.productPrice}})">
                                    </div>
                                    <button style="width: 100px;" type="submit"
                                        onclick="cartDeleteProduct('{{this._id}}','{{this.product._id}}')"
                                        class="btn btn-danger btn-sm mt-2">Remove</button>
                                </div>
                            </div>
                        </div>
                        <div class="my-auto col-7">
                            <div style="justify-content: flex-end;" class="row text-right">
                                <div class="col-4">
                                    <h6 class="mob-text">{{this.product.productPrice}}</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
                <div class="totalprice d-flex justify-content-end border-top">
                    <div class="totalbg">
                        <div class="total">
                            <p>SubTotal <span style="margin-left: 10px;" id="cartTotallabel">₹{{total}}</span>
                            </p>
                        </div>
                        <div class="d-flex justify-content-end">
                            <a href="" class="btn btn-dark">checkout</a>
                        </div>

                    </div>
                </div>
                <p style="margin-top: 10px;" id="shippingchargelabel">shipping charges may apply, kindly check the
                    shipping charges while
                    checking out </p>
                {{else}}
                <h1 style="text-align: center;padding: 50px;"><span class="fa fa-shopping-cart"></span> Shopping cart is
                    empty</h1>

                {{/if}}
            </div>
        </div>
    </div>
</section>
<section class="w3l-grids-hny-2">
    <div class="grids-hny-2-mian ">
        <div class="container py-lg-5">
            <h3 class="hny-title mb-0 text-center">You Might <span>Like</span></h3>
        </div>
    </div>
</section>
<section class="w3l-ecommerce-main">
    <div class="ecom-contenthny ">
        <div class="container ">
            <div class="ecom-products-grids row mt-lg-5 mt-3">
                {{#each productsDisplay}}
                <div class="col-lg-3 col-6 product-incfhny mt-4">
                    <div class="product-grid2 transmitv">
                        <div class="product-image2"> <a href="#"> <img loading="eager" style="width: 350px;height: 450;"
                                    class="pic-1 img-fluid" src="images/products/{{this._id}}.jpg"> <img loading="eager"
                                    class="pic-2 img-fluid" src="images/products/{{this._id}}1.jpg"> </a>
                            <ul class="social">
                                <li><a href="#" data-tip="Quick View"><span class="fa fa-eye"></span></a></li>
                                <li><a data-tip="Add to Cart"><span class="fa fa-shopping-bag"></span></a></li>
                            </ul>
                            <div class="transmitv single-item">
                                <a style="cursor: pointer;" id="addToCartBtn" onclick="addToCart('{{this._id}}')"
                                    class="transmitv-cart ptransmitv-cart add-to-cart">
                                    Add to Cart</a>
                            </div>
                        </div>
                        <div class="product-content">
                            <h3 class="title"><a href="#">{{this.productName}} </a></h3> <span
                                class="price"><del>₹2000</del>{{this.productPrice}}</span>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>