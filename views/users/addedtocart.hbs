<section class="editaddresscontainer">
    <div class="container">
        <div class="signinwrap wrap" style="padding-bottom: 20px;">
            <h5 class="signintext text-center ">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Added to cart <i id="addedtocarttickmark" class="fa fa-check-circle"
                    style="color: rgb(20, 235, 20);"></i>
            </h5>
        </div>
        <div class="addedtocartbg">
            <div class="productdetails">
                <div class="prodetails d-flex">
                    <a href=""><img src="images/products/{{product._id}}.jpg" alt=""></a>
                    <div class="prodetails1">
                        <a href="">{{product.name}}</a>
                        <p>{{product.category}}</p>
                        <p>₹{{product.selling_price}}</p>
                    </div>
                </div>
                <div class="navigations">
                    <a style="color: white" class="btn btn-dark" href="/mycart">Cart</a>
                    <a href="/checkout" class="btn btn-dark">Checkout</a>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="w3l-grids-hny-2">
    <div class="grids-hny-2-mian ">
        <div class="container py-lg-5">
            <h3 class="hny-title mb-0 text-center">You Might <span>Like</span></h3>
        </div>
    </div>
</section>
<section class="w3l-ecommerce-main">
    <div class="ecom-contenthny ">
        <div class="container ">
            <div class="ecom-products-grids row mt-lg-5 mt-3">
                {{#each productsDisplay}}
                <div class="col-lg-3 col-6 product-incfhny mt-4">
                    <div class="product-grid2 transmitv">
                        <div class="product-image2"> <a href="#"> <img loading="eager" style="width: 350px;height: 450;"
                                    class="pic-1 img-fluid" src="images/products/{{this._id}}.jpg"> <img loading="eager"
                                    class="pic-2 img-fluid" src="images/products/{{this._id}}1.jpg"> </a>
                            <ul class="social">
                                <li><a href="#" style="cursor: pointer;"><span class="fa fa-eye"></span></a></li>
                                <li><a style="cursor: pointer;" onclick="addToCart('{{this._id}}')"><span
                                            class="fa fa-shopping-bag"></span></a></li>
                            </ul>
                            <div class="transmitv single-item">
                                <a style="cursor: pointer;" id="addToCartBtn" onclick="addToCart('{{this._id}}')"
                                    class="transmitv-cart ptransmitv-cart add-to-cart">
                                    Add to Cart</a>
                            </div>
                        </div>
                        <div class="product-content">
                            <h3 class="title"><a href="#">{{this.name}} </a></h3> <span
                                class="price"><del>₹2000</del>{{this.selling_price}}</span>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>