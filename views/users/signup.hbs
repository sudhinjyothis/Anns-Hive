<section class="signupcontainer">
    <div class="container">
        <div class="wrap">
            <h5 class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Sign Up
            </h5>
            <div class="signupbg bg p-md-5 p-4 mx-auto mw-100">
                <!--/SignUp-form-->
                <form class="row g-3">
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" id="name" required>
                        <label class="commonerrormsg" id="errlab1">Name cannot be empty !</label>
                    </div>
                    <div class="col-md-12 col-12 signupemail">
                        <label for="email" class="form-label">Email </label>
                        <img id="emailLoad" class="loading" src="/images/Spinner-3.gif" alt="">
                        <input type="email" required class="form-control" name="email" id="signupemail">
                        <label class="commonerrormsg" id="emailCheckStatus">Email alreadyExists !</label>
                        <label class="commonerrormsg" id="errlab2">Email cannot be empty !</label>
                        <label class="commonerrormsg" id="invalidEmail">Invalid Email Address</label>
                    </div>
                    <div class="col-md-12 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <input type="password" maxlength="16" class="form-control" required name="password"
                            id="Password">
                        <label class="commonerrormsg" id="errlab3">password cannot be empty !</label>
                        <label class="commonerrormsg" id="passreq1">Minimum of 6 characters required</label>
                        <label class="commonerrormsg" id="passreq2">Should contain atleast one integer</label>
                        <label class="commonerrormsg" id="passreq3">Should contain atleast one uppercase
                            character</label>
                    </div>
                    <div class="col-md-12 col-12">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" maxlength="16" class="form-control" required name="confirmpassword"
                            id="confirmPassword">
                        <label class="commonerrormsg" id="passwordcheck">Password doesnt match!</label>
                        <label style="margin-top: 10px;margin-left: 10px;">
                            <ul>
                                <li>
                                    Minimum 6 characters and maximum 16 characters
                                </li>
                                <li>
                                    Should contain atleast one integer
                                </li>
                                <li>
                                    Should contain atleast one uppercase character
                                </li>
                            </ul>
                        </label>
                    </div>
                    <div class="col-md-8">
                        <label class="commonerrormsg" id="captchacheck">Please Verify you are not a robot</label>
                    </div>
                    <div style="margin-left: 10px;overflow: hidden;" class="g-recaptcha"
                        data-sitekey="6Le02TQbAAAAABaqUAYIM2HA2KN-hQ6ylzGQ4qWi"></div>
                    <div class="col-12">
                        <button id="signupbtn" style="margin-bottom: 10px;" type="submit" class="btn btn-dark">Sign
                            Up</button>
                        <p style="color: #505050;margin-top: 10px;">By continuing you agree to our terms and
                            conditions</p>
                    </div>
                </form>
                <a href="/signin" style="color: #505050;text-decoration: underline;">Already a member?
                    sign in</a>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
    </div>
</section>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>