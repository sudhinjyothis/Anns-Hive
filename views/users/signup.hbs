<section class="signupcontainer">
    <div class="container">
        <div class="wrap">
            <h5 class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Sign Up
            </h5>
            <div class="signbg bg p-md-5 p-4 mx-auto mw-100">
                <!--/SignUp-form-->
                <form class="row g-3">
                    <div class="col-md-6 col-6">
                        <label for="inputEmail4" class="form-label">FirstName</label>
                        <input type="text" class="form-control" id="Firstname">
                    </div>
                    <div class="col-md-6 col-6">
                        <label for="inputPassword4" class="form-label">LastName</label>
                        <input type="text" class="form-control" id="LastName">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputEmail4" class="form-label">Email</label>
                        <input type="email" class="form-control" id="inputEmail4">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <input type="password" class="form-control" id="inputPassword4">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputPassword4" class="form-label">Mobile</label>
                        <input type="number" class="form-control" id="inputPassword4">
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="inputAddress" class="form-label">Address</label>
                        <input type="text" class="form-control" id="inputAddress" placeholder="1234 Main St">
                    </div>
                    <div class="col-md-6 col-12">
                        <label for="inputCity" class="form-label">City</label>
                        <input type="text" class="form-control" id="inputCity">
                    </div>
                    <div class="col-md-4 col-7">
                        <label for="inputState" class="form-label">State</label>
                        <select id="inputState" class="form-select">
                            <option selected>Andhra Pradesh</option>
                            {{#each indian_states}}
                            <option>{{this}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="col-md-2 col-5">
                        <label for="inputZip" class="form-label">Zip</label>
                        <input type="number" class="form-control" id="inputZip">
                    </div>
                    <div class="col-12">
                        <button style="margin-bottom: 10px;" type="submit" class="btn btn-outline-warning">Sign
                            Up</button>
                    </div>
                </form>
                <a href="/signin" style="color: #adb5bd;text-decoration: underline;">Already a member?
                    sign in</a>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
    </div>
</section>