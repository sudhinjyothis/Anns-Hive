<section class="signupcontainer">
    <div class="container">
        <div class="wrap">
            <h5 class="signuptext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Sign Up
            </h5>
            <div class="signupbg bg p-md-5 p-4 mx-auto mw-100">
                <!--/SignUp-form-->
                <form class="row g-3">
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Name</label>
                        <input type="text" class="form-control" required name="name" id="name">
                    </div>
                    <div class="col-md-12 col-12 signupemail">
                        <label for="email" class="form-label">Email <span class="emailnotexists"
                                id="emailCheckStatus">Email already
                                Exists !</span></label>
                        <img id="emailLoad" class="loading" src="/images/Spinner-3.gif" alt="">
                        <input type="email" required class="form-control" name="email" id="signupemail"
                            onblur="emailcheck(this.value)">
                    </div>
                    <div class="col-md-12 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <input type="password" class="form-control" required name="password" id="Password">
                    </div>
                    <div class="col-md-12 col-12">
                        <label class="form-label">Confirm Password<span class="emailnotexists"
                                id="passwordcheck">Password
                                doesnt
                                match!</span></label>
                        <input type="password" class="form-control" required name="confirmpassword"
                            id="confirmPassword">
                    </div>
                    <span style="margin-top: 10px;margin-left: 10px;" class="emailnotexists" id="captchacheck">Please
                        Verify you are not a
                        robot</span>
                    <div style="margin-left: 10px;overflow: hidden;" class="g-recaptcha"
                        data-sitekey="6Le02TQbAAAAABaqUAYIM2HA2KN-hQ6ylzGQ4qWi"></div>
                    <div class="col-12">
                        <button id="signupbtn" style="margin-bottom: 10px;" type="submit"
                            class="btn btn-outline-warning">Sign Up</button>
                        <p style="color: #adb5bd;margin-top: 10px;">By continuing you agree to our terms and
                            conditions</p>
                    </div>
                </form>
                <a href="/signin" style="color: #adb5bd;text-decoration: underline;">Already a member?
                    sign in</a>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
    </div>
</section>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>