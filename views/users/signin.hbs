<section class="signupcontainer">
    <div class="container">
        <div class="signinwrap wrap">
            <h5 class="signintext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Sign In
            </h5>
            <div class="signbg bg p-md-5 p-4 mx-auto mw-100">
                <!--/SignUp-form-->
                <form class="row g-3">
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Email/mobile</label>
                        <input type="text" class="form-control" id="Firstname">
                    </div>
                    <div class="col-md-12 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <input type="text" class="form-control" id="LastName">
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="gridCheck">
                            <label class="form-check-label" for="gridCheck">
                                Remember Me
                            </label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-warning">Sign In</button>
                    </div>
                </form>
                <label style="margin-top: 10px;color: #adb5bd;" class="form-label">Sign in with google /
                    facebook</label>
                <div class="socialmedialogin">
                    <div class="googlesign g-signin2" data-onsuccess="onSignIn"></div>
                    <div class="fbsignin">
                        <fb:login-button scope="public_profile,email" onlogin="checkLoginState();">
                        </fb:login-button>
                    </div>
                </div>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
    </div>
</section>
<script src="https://apis.google.com/js/platform.js" async defer></script>
<script>
    window.fbAsyncInit = function () {
        FB.init({
            appId: '901671164022470',
            cookie: true,
            xfbml: true,
            version: 'v10.0'
        });

        FB.AppEvents.logPageView();

    };

    (function (d, s, id) {
        var js, fjs = d.getElementsByTagName(s)[0];
        if (d.getElementById(id)) { return; }
        js = d.createElement(s); js.id = id;
        js.src = "https://connect.facebook.net/en_US/sdk.js";
        fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));
</script>