<section class="signincontainer">
    <div class="container">
        <div class="signinwrap wrap">
            <h5 class="signintext text-center mb-4">
                <img class="signlogo" src="images/logo.png" alt="Logo" title="Your logo" style="height:35px;" />
                Sign In
            </h5>
            <div class="signinbg bg p-md-5  mx-auto mw-100">
                <!--/SignUp-form-->
                <form class="row g-3">
                    <div style="margin: 0;" class="col-md-8">
                        <label style="color: #000000;" class="signinerrmsg" id="signinErrMsg">Invalid Email or
                            Password</label>
                    </div>
                    <div class="col-md-12 col-12">
                        <label for="inputEmail4" class="form-label">Email</label>
                        <input type="text" class="form-control" id="signinEmail">
                    </div>
                    <div style="position: relative;" class="col-md-12 col-12">
                        <label for="inputPassword4" class="form-label">Password</label>
                        <input type="password" class="form-control" id="signinPassword">
                        <i style="cursor: pointer;position: absolute;top: 41px;right: 25px;font-size: 17px;"
                            class="fa fa-eye-slash" id="passwordeye"></i>
                    </div>
                    <div style="margin-left: 20px;" class="form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMeCheck">
                        <label class="form-check-label" for="rememberMeCheck">Remember me</label>
                    </div>
                    <div class="col-12">
                        <button type="submit" id="signinBtn" class="btn btn-dark">Sign In</button>
                    </div>
                </form>
                <label style="margin-top: 10px;color: #505050;" class="form-label">Sign in with google /
                    facebook</label>
                <div class="socialmedialogin">
                    <div class="googlesign g-signin2" data-onsuccess="onSignIn"></div>
                    <div class="">
                        {{!-- <div class="fb-login-button" data-width="" data-size="medium"
                            data-button-type="login_with" data-layout="default" data-auto-logout-link="false"
                            data-use-continue-as="true"></div> --}}
                        <a href="/api/facebookauth" class="facebookbtn btn btn-primary"><span
                                class="fa fa-facebook"></span> Sign
                            in</a>
                    </div>
                </div>
                <a href="/signup" style="color: #505050;text-decoration: underline;">New to this site? sign up</a>
                <!--//SignUp-form-->
            </div>
            <!---->
        </div>
    </div>
</section>
<script src="https://apis.google.com/js/platform.js" async defer></script>

